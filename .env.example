# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Portfolio Configuration
VITE_SITE_URL="https://alexmorgan.dev"
VITE_CONTACT_EMAIL="alex.morgan.dev@gmail.com"

# Social Wall API Configuration
# GITHUB_TOKEN: Optional personal access token for higher rate limits on GitHub API (5,000 req/hr vs 60 req/hr).
GITHUB_TOKEN=""
# GITHUB_USERNAME: GitHub username to fetch real-time public commits, forks, and repo events from.
GITHUB_USERNAME="kimsan-developer"
# LINKEDIN_ACCESS_TOKEN: OAuth 2.0 access token to fetch real-time LinkedIn member posts and shares via LinkedIn REST API.
LINKEDIN_ACCESS_TOKEN=""
# LINKEDIN_PERSON_URN: Optional LinkedIn member URN (e.g., urn:li:person:abcdef1234)
LINKEDIN_PERSON_URN=""

